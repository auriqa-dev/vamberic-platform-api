NODE_ENV=development
DEPLOYMENT_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017
PORT=5000
SERVICE_NAME=vamberic-studio-platform-api
API_VERSION=0.1.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Public Cognito identifiers, supplied by vamberic-infrastructure.
AWS_REGION=eu-west-2
COGNITO_USER_POOL_ID=eu-west-2_REPLACE
COGNITO_CLIENT_ID=replacewithclientid
# Separate allowlist for unauthenticated product enquiry forms. No wildcard.
# Example deployed value: https://h-v-m.agency
PUBLIC_ENQUIRY_CORS_ORIGINS=http://localhost:3000
# Requests per client IP per 60 seconds, per API process (1–20; default 5).
PUBLIC_ENQUIRY_RATE_LIMIT_MAX_REQUESTS=5

# Optional internal operational email; default disabled. No AWS keys here.
NOTIFICATION_EMAIL_ENABLED=false
# Required only when enabled: a sender verified in SES in AWS_REGION.
# NOTIFICATION_EMAIL_FROM=notifications@example.com
# JSON object: real Product IDs -> arrays of 1–50 recipient email addresses.
PRODUCT_ENQUIRY_NOTIFICATION_RECIPIENTS_JSON={}
