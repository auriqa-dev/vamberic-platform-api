{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "targetKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "update" },
            "reference": {
              "type": "object",
              "properties": {
                "resourceType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "workspaceId": {
                  "type": "string",
                  "pattern": "^workspace_[0-7][0-9abcdefghjkmnpqrstvwxyz]{25}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "required": ["resourceType", "id", "workspaceId", "contentHash"],
              "additionalProperties": false
            },
            "expectedUpdatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": ["kind", "reference"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "create" },
            "parents": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relationship": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "reference": {
                    "type": "object",
                    "properties": {
                      "resourceType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "workspaceId": {
                        "type": "string",
                        "pattern": "^workspace_[0-7][0-9abcdefghjkmnpqrstvwxyz]{25}$"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "resourceType",
                      "id",
                      "workspaceId",
                      "contentHash"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["relationship", "reference"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "parents"],
          "additionalProperties": false
        }
      ]
    },
    "candidate": { "$ref": "#/$defs/__schema0" },
    "evidenceIds": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "lineageIds": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    }
  },
  "required": [
    "id",
    "targetKind",
    "target",
    "candidate",
    "evidenceIds",
    "rationale",
    "lineageIds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  },
  "x-protocol-version": "1.2",
  "x-runtime-validation": "Zod plus canonicalJson is authoritative. JSON Schema omits digest, byte/depth, scope, chronology, completeness and cross-reference refinements."
}
