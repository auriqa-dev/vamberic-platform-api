{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "effectiveness_evaluation_request" },
    "schemaVersion": { "type": "number", "const": 1 },
    "candidate": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 3 },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "resultId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "envelopeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "domain_output" }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "proposal" },
                "proposalId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                }
              },
              "required": ["kind", "proposalId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "artifact" },
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                }
              },
              "required": ["kind", "artifactId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "caseId",
        "revision",
        "runId",
        "attemptId",
        "resultId",
        "envelopeDigest",
        "contentDigest",
        "selector"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "profile": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["key", "version", "digest"],
          "additionalProperties": false
        },
        "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "intendedNextAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "lineage": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "role": {
                "type": "string",
                "enum": ["requested", "consumed", "proposal_base"]
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "const": "resource" },
                      "reference": {
                        "type": "object",
                        "properties": {
                          "resourceType": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                          },
                          "workspaceId": {
                            "type": "string",
                            "pattern": "^workspace_[0-7][0-9abcdefghjkmnpqrstvwxyz]{25}$"
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000
                          },
                          "revision": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000
                          },
                          "contentHash": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "resourceType",
                          "id",
                          "workspaceId",
                          "contentHash"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": ["kind", "reference"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "const": "external" },
                      "url": {
                        "type": "string",
                        "maxLength": 2000,
                        "format": "uri"
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": ["kind", "url", "contentHash"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "const": "artifact" },
                      "artifactId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": ["kind", "artifactId", "contentHash"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "const": "input" },
                      "requestId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": ["kind", "requestId", "contentHash"],
                    "additionalProperties": false
                  }
                ]
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "fields": {
                "minItems": 1,
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)*$"
                }
              },
              "snapshotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "artifactId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              }
            },
            "required": [
              "id",
              "role",
              "purpose",
              "source",
              "observedAt",
              "fetchedAt"
            ],
            "additionalProperties": false
          }
        },
        "criteria": {
          "minItems": 1,
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "category": {
                "type": "string",
                "enum": ["validity", "effectiveness", "brand"]
              },
              "requirement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "importance": {
                "type": "string",
                "enum": ["mandatory", "advisory"]
              },
              "method": {
                "type": "string",
                "enum": ["deterministic", "judgement"]
              },
              "methodKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "evidence": { "type": "string", "enum": ["none", "required"] },
              "applicabilityRule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "consequenceKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "lineageIds": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                }
              }
            },
            "required": [
              "id",
              "version",
              "category",
              "requirement",
              "rationale",
              "importance",
              "method",
              "methodKey",
              "evidence",
              "applicabilityRule",
              "consequenceKey",
              "lineageIds"
            ],
            "additionalProperties": false
          }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "schemaVersion",
        "profile",
        "objective",
        "intendedNextAction",
        "lineage",
        "criteria",
        "digest"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["key", "version", "digest"],
      "additionalProperties": false
    },
    "requestKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "instruction": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": ["version", "hash", "key"],
      "additionalProperties": false
    },
    "importedSupport": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "localEvidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sourceResultId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sourceEnvelopeDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceEvidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sourceEvidenceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "localEvidenceId",
          "sourceResultId",
          "sourceEnvelopeDigest",
          "sourceEvidenceId",
          "sourceEvidenceDigest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "candidate",
    "criteria",
    "policy",
    "requestKey",
    "instruction",
    "importedSupport"
  ],
  "additionalProperties": false,
  "x-protocol-version": "1.2",
  "x-runtime-validation": "Zod plus canonicalJson is authoritative. JSON Schema omits digest, byte/depth, scope, chronology, completeness and cross-reference refinements."
}
