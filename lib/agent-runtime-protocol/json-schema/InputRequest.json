{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "schemaKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "fields": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "required": { "type": "boolean" },
              "type": { "type": "string", "const": "text" },
              "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 }
            },
            "required": ["key", "label", "required", "type", "maxLength"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "required": { "type": "boolean" },
              "type": { "type": "string", "const": "choice" },
              "options": {
                "minItems": 2,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": ["value", "label"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["key", "label", "required", "type", "options"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "required": { "type": "boolean" },
              "type": { "type": "string", "const": "boolean" }
            },
            "required": ["key", "label", "required", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "required": { "type": "boolean" },
              "type": { "type": "string", "const": "number" },
              "minimum": {
                "type": "number",
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "maximum": {
                "type": "number",
                "minimum": -1000000000,
                "maximum": 1000000000
              }
            },
            "required": [
              "key",
              "label",
              "required",
              "type",
              "minimum",
              "maximum"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["id", "digest"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "schemaKey",
    "schemaVersion",
    "question",
    "reason",
    "fields",
    "expiresAt",
    "checkpoint"
  ],
  "additionalProperties": false,
  "x-protocol-version": "1.2",
  "x-runtime-validation": "Zod plus canonicalJson is authoritative. JSON Schema omits digest, byte/depth, scope, chronology, completeness and cross-reference refinements."
}
